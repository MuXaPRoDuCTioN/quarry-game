# Godot 4+ specific ignores
.godot/

# Imported translations (automatically generated from CSV files)
*.translation

# Compiled files
*.pck
*.exe

# Import files (generated by Godot)
*.import

# UID files (Godot 4+)
*.uid

# Export presets (may contain personal paths)
export_presets.cfg

# If using C#, you might also want to ignore the .mono folder
# .mono/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini